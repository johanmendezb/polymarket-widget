# Server-side only. NEVER prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_BASE=https://clob.polymarket.com
# AI_SAMPLES=5
# AI_TIMEOUT_MS=45000

# Set by Render in staging. Not needed locally.
# PORT=3000
# RENDER_GIT_COMMIT=

# Staging URL, used by `pnpm warm`. Not a secret.
# STAGING_URL=

# --- Cost controls (Anthropic API credits) ---
# A forecast costs AI_SAMPLES model calls, plus one more if the anchored
# diagnostic is on. Defaults are 5 + 1 = six calls per forecast on Opus.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # override ADR-0005's claude-opus-5
# AI_SAMPLES=1                                # 5 -> 1 loses dispersion, saves 80%
# AI_ANCHORED=0                               # skip the anchored diagnostic call
# AI_CACHE_TTL_MS=900000                      # forecast cache window, default 15m
